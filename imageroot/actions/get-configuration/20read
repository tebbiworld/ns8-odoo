import os
import sys
import json
import subprocess
import agent


def _running(name):
    try:
        out = subprocess.run(["podman", "inspect", name, "--format", "{{.State.Status}}"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
        return out == "running"
    except Exception:
        return False


config = {}
config["host"] = os.getenv("TRAEFIK_HOST", "")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"
config["timezone"] = os.getenv("TZ", "UTC")

try:
    route = agent.get_route(os.environ["MODULE_ID"])
    config["lets_encrypt"] = route.get("lets_encrypt", False)
except Exception:
    config["lets_encrypt"] = False

# Runtime options.
config["workers"] = int(os.getenv("ODOO_WORKERS", "0") or 0)
config["list_db"] = os.getenv("ODOO_LIST_DB", "True") == "True"
# Never return the master password; only whether one is set.
config["master_password_set"] = bool(os.getenv("ODOO_MASTER_PASSWORD", ""))

# Live state so the UI can show status and a link.
config["db_running"] = _running("odoo-db")
config["app_running"] = _running("odoo-app")
config["running"] = config["db_running"] and config["app_running"]
config["url"] = ("https://" + config["host"] + "/") if config["host"] else ""
config["database_manager_url"] = ("https://" + config["host"] + "/web/database/manager") if config["host"] else ""

# Directory login (Odoo auth_ldap), applied per database with apply-ldap.
config["ldap_enabled"] = os.getenv("LDAP_ENABLED", "false") == "true"
config["ldap_server"] = os.getenv("LDAP_SERVER", "")
config["ldap_port"] = int(os.getenv("LDAP_PORT", "389") or 389)
config["ldap_tls"] = os.getenv("LDAP_TLS", "false") == "true"
config["ldap_binddn"] = os.getenv("LDAP_BINDDN", "")
config["ldap_base"] = os.getenv("LDAP_BASE", "")
config["ldap_filter"] = os.getenv("LDAP_FILTER", "")
config["ldap_create_user"] = os.getenv("LDAP_CREATE_USER", "true") == "true"
config["ldap_verify_cert"] = os.getenv("LDAP_TLS_REQCERT", "never") == "demand"
config["ldap_password_set"] = bool(os.getenv("LDAP_PASSWORD", ""))

# List of Odoo databases (for the LDAP "apply to" selector).
try:
    out = subprocess.run(
        ["podman", "exec", "odoo-db", "psql", "-U", "odoo", "-d", "postgres", "-tAc",
         "SELECT datname FROM pg_database WHERE datistemplate=false AND datname <> 'postgres' ORDER BY datname"],
        capture_output=True, text=True, timeout=15)
    config["databases"] = [l.strip() for l in out.stdout.splitlines() if l.strip()] if out.returncode == 0 else []
except Exception:
    config["databases"] = []

json.dump(config, fp=sys.stdout)

# Generate the module secrets into state/passwords.env (mode 0600). The file is
# listed in etc/state-include.conf, loaded by the units with EnvironmentFile=
# and never written to state/environment (which is copied to Redis).

import os
import secrets
import agent

path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
pw = agent.read_envfile(path) if os.path.exists(path) else {}
pw.setdefault("POSTGRES_PASSWORD", secrets.token_hex(16))
pw.setdefault("ODOO_MASTER_PASSWORD", secrets.token_urlsafe(15))
old_umask = os.umask(0o077)
try:
    agent.write_envfile(path, pw)
finally:
    os.umask(old_umask)
os.chmod(path, 0o600)

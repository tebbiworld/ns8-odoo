# Non-secret defaults only. Secrets are generated by 10genpasswords into
# state/passwords.env: state/environment is mirrored to Redis in plain text.

import agent

# Odoo workers: 0 = threaded mode (one HTTP port, websocket/live-chat works
# behind a single Traefik route). Raise it only with a dedicated gevent route.
agent.set_env("ODOO_WORKERS", "0")
agent.set_env("ODOO_LIST_DB", "True")
agent.set_env("TZ", "UTC")
# auth_ldap (python-ldap) honours LDAPTLS_REQCERT for StartTLS.
agent.set_env("LDAP_TLS_REQCERT", "never")

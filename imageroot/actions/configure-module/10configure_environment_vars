import os
import sys
import json
import agent

data = json.load(sys.stdin)

agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
if "lets_encrypt" in data:
    # kept so restore-module can re-create the route with the same setting
    agent.set_env("TRAEFIK_LETS_ENCRYPT", data["lets_encrypt"])

# Optional time-zone override for the container OS.
if (data.get("timezone") or "").strip():
    agent.set_env("TZ", data["timezone"].strip())

# Odoo worker model: 0 = threaded (single HTTP port, live-chat websocket works
# on it, one Traefik route). A positive number switches to multiprocess.
workers = data.get("workers")
if workers is not None:
    try:
        agent.set_env("ODOO_WORKERS", str(max(0, int(workers))))
    except (TypeError, ValueError):
        pass

# Expose the database list / manager (still master-password protected).
if "list_db" in data:
    agent.set_env("ODOO_LIST_DB", "True" if data.get("list_db") else "False")

# Master (admin) password for the database manager. Only overwrite it when a
# non-empty value is supplied, so leaving the field blank keeps the stored one.
# Secrets go to state/passwords.env (0600), never to state/environment.
secrets_changed = {}
master = (data.get("master_password") or "").strip()
if master:
    secrets_changed["ODOO_MASTER_PASSWORD"] = master

# --- Directory login (Odoo auth_ldap) ---------------------------------------
# Stored here; applied to a database with the apply-ldap action (Odoo keeps the
# LDAP config per database, and a database only exists once the admin has
# created one). Fields map 1:1 to res.company.ldap. For Active Directory use
# port 389 with StartTLS on (AD accepts StartTLS but refuses plain 389); the
# filter is typically (sAMAccountName=%s) for AD, (uid=%s) for OpenLDAP.
agent.set_env("LDAP_ENABLED", "true" if data.get("ldap_enabled", False) else "false")
if "ldap_verify_cert" in data:
    agent.set_env("LDAP_TLS_REQCERT", "demand" if data.get("ldap_verify_cert") else "never")
if "ldap_server" in data:
    agent.set_env("LDAP_SERVER", (data.get("ldap_server") or "").strip())
if data.get("ldap_port") is not None:
    try:
        agent.set_env("LDAP_PORT", str(int(data["ldap_port"])))
    except (TypeError, ValueError):
        pass
if "ldap_tls" in data:
    agent.set_env("LDAP_TLS", "true" if data.get("ldap_tls") else "false")
if "ldap_binddn" in data:
    agent.set_env("LDAP_BINDDN", (data.get("ldap_binddn") or "").strip())
if "ldap_base" in data:
    agent.set_env("LDAP_BASE", (data.get("ldap_base") or "").strip())
if "ldap_filter" in data:
    agent.set_env("LDAP_FILTER", (data.get("ldap_filter") or "").strip())
if "ldap_create_user" in data:
    agent.set_env("LDAP_CREATE_USER", "true" if data.get("ldap_create_user") else "false")
# Keep the stored bind password when the field is left empty on a reconfigure.
ldap_password = data.get("ldap_password")
if ldap_password:
    secrets_changed["LDAP_PASSWORD"] = ldap_password

if secrets_changed:
    path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
    pw = agent.read_envfile(path) if os.path.exists(path) else {}
    pw.update(secrets_changed)
    old_umask = os.umask(0o077)
    try:
        agent.write_envfile(path, pw)
    finally:
        os.umask(old_umask)
    os.chmod(path, 0o600)

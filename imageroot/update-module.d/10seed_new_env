# Runs on module update. Seed any runtime option that a value-less older
# instance might be missing, so the app unit never expands it to an empty
# string. Administrator-set values are preserved.

import os
import agent

envfile = os.path.join(os.environ["AGENT_STATE_DIR"], "environment")
env = agent.read_envfile(envfile)


def ensure(key, value):
    if not env.get(key):
        agent.set_env(key, value)


ensure("ODOO_WORKERS", "0")
ensure("ODOO_LIST_DB", "True")
ensure("TZ", "UTC")

# The node agent's update-module action extracts the new image and runs these
# hooks but does not restart the units. Re-render the config and restart the pod
# so a changed unit file or config takes effect immediately.

set -e
exec 1>&2

runagent render-config || true
systemctl --user daemon-reload
systemctl --user restart odoo.service

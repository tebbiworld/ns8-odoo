# Up to 1.0.0 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them to
# state/passwords.env (0600) and drop them from the environment.

import os
import sys
import agent

SECRETS = ["POSTGRES_PASSWORD", "ODOO_MASTER_PASSWORD", "LDAP_PASSWORD"]

state = os.environ["AGENT_STATE_DIR"]
env = agent.read_envfile(os.path.join(state, "environment"))
path = os.path.join(state, "passwords.env")
pw = agent.read_envfile(path) if os.path.exists(path) else {}

moved = [k for k in SECRETS if env.get(k)]
for k in moved:
    pw.setdefault(k, env[k])
if moved or not os.path.exists(path):
    old_umask = os.umask(0o077)
    try:
        agent.write_envfile(path, pw)
    finally:
        os.umask(old_umask)
os.chmod(path, 0o600)
leftover = [k for k in SECRETS if k in env]
if leftover:
    agent.munset_env(leftover)
    print("moved to passwords.env: " + " ".join(leftover), file=sys.stderr)
